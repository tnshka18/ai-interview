# Server
PORT=5000
NODE_ENV=development

# Database (optional — app runs in mock mode without it)
MONGO_URI=mongodb://localhost:27017/interview-ai

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:3000

# AWS / Storage (production only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=interview-ai-chunks
AWS_REGION=ap-south-1

# Deepgram (transcription, production only)
DEEPGRAM_API_KEY=
